{
  "name": "bible-visualizer",
  "version": "0.0.0",
  "private": true,
  "description": "An interactive, accurate, and visual way to understand the Bible.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "vercel-build": "pnpm --filter @bible-visualizer/db exec prisma migrate deploy && pnpm --filter @bible-visualizer/web build",
    "postinstall": "pnpm --filter @bible-visualizer/db exec prisma generate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "turbo": "2.9.6",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
